{
  "name": "halgheh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run",
    "android:apk": "pnpm build && cap sync android </dev/null && cd android && JAVA_HOME=\"$(cd .. && node scripts/jdk.mjs)\" ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ./gradlew assembleDebug",
    "android:live": "./scripts/dev-android.sh",
    "android:release": "pnpm build && cap sync android </dev/null && cd android && JAVA_HOME=\"$(cd .. && node scripts/jdk.mjs)\" ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ./gradlew assembleRelease && mkdir -p ../release && cp app/build/outputs/apk/release/app-release.apk ../release/halgheh.apk",
    "version": "node -e \"const v=require('./package.json').version.split('.').map(Number);console.log(v[0]*10000+v[1]*100+v[2])\"",
    "jdk": "node scripts/jdk.mjs"
  },
  "dependencies": {
    "@capacitor-community/contacts": "8.0.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "8.1.1",
    "@fontsource/vazirmatn": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.3"
  }
}
